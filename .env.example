# =================================================================
# HUMSAFAR (हमसफ़र) ENVIRONMENT CONFIGURATION
# =================================================================

# Google Gemini API Key for AI Scam Shield and Medical Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional - in-memory persistence used if not set)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Guardian Emergency Alert Webhook (SMS / WhatsApp gateway integration)
GUARDIAN_ALERT_WEBHOOK_URL=https://api.whatsapp.com/send
GUARDIAN_DEFAULT_PHONE=+919876543210
